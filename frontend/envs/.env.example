# Copy this file to envs/.env and fill in the values.

# Base URL of the backend API, without a trailing slash.
VITE_BACKEND_HOST=https://your-backend-host

# How often the dashboard refreshes balances, in milliseconds (minimum 1000).
VITE_BALANCE_POLL_INTERVAL_MS=5000

# How often the dashboard refreshes open orders, in milliseconds (minimum 1000).
VITE_ORDERS_POLL_INTERVAL_MS=5000

# How often the dashboard refreshes the latest trades, in milliseconds (minimum 1000).
VITE_TRADES_POLL_INTERVAL_MS=5000
