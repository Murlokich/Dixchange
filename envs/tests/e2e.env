# Settings of the e2e tests themselves, not of the app. Loaded by make test-e2e.

# Randomized suite (test/e2e/randomized_test.go).
E2E_RANDOM_USERS=4
E2E_RANDOM_COMMANDS=300
E2E_RANDOM_VALIDATE_EVERY=50
# 0 disables the crashes.
E2E_RANDOM_CRASH_EVERY=100
# Where a failed run writes its log, relative to test/e2e (the tests' working directory).
E2E_RANDOM_LOG_DIR=out
# Set to replay a failed run; when unset, every run picks its own seed.
# E2E_RANDOM_SEED=
