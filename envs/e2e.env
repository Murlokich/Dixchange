# Loaded by make test-e2e, taking precedence over envs/.env. Holds only the values
# the e2e tests deliberately run differently from the app. Don't copy values here
# to match the app: a copy goes stale when the app's value changes.

# Hashing only costs time in the tests (64 MiB per registration by default); they register
# many users and don't test hashing.
ARGON2_MEMORY=8192
